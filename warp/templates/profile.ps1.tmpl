# RENDERED FILE - do not edit by hand.
# Source of truth: agentic-os/warp/templates/profile.ps1.tmpl
# Rendered and symlinked to the pwsh 7 $PROFILE by `ward exec warp apply`.
#
# Auto-cd into the configured startup dir on shell start, matching Warp's
# StartupDir (settings.toml / startup_config.toml): the projects root by
# default, or a WARP_STARTUP_DIR override. Warp on the Windows host launches
# pwsh 7, so this is what lands new tabs. Guarded so the shell still opens
# cleanly if the directory is unmapped.
if (Test-Path '{{ .StartupDir }}') {
    Set-Location -Path '{{ .StartupDir }}'
}

# Import the declarative shared exports from common.sh without starting Bash.
# common.sh owns the values. This loader accepts quoted literals and $HOME.
$_commonShellPath = '{{ .RepoRoot }}/shell/common.sh'
if (Test-Path -LiteralPath $_commonShellPath) {
    $_insideSharedEnvironment = $false
    foreach ($_line in [System.IO.File]::ReadLines($_commonShellPath)) {
        if ($_line -eq '# shared-environment: begin') {
            $_insideSharedEnvironment = $true
            continue
        }
        if ($_line -eq '# shared-environment: end') {
            break
        }
        if ($_insideSharedEnvironment -and $_line -match '^export ([A-Za-z_][A-Za-z0-9_]*)=(.*)$') {
            $_name = $Matches[1]
            $_value = $Matches[2].Trim()
            if ($_value.Length -ge 2 -and (
                ($_value.StartsWith('"') -and $_value.EndsWith('"')) -or
                ($_value.StartsWith("'") -and $_value.EndsWith("'"))
            )) {
                $_value = $_value.Substring(1, $_value.Length - 2)
            }
            $_value = $_value.Replace('${HOME}', $HOME).Replace('$HOME', $HOME)
            [System.Environment]::SetEnvironmentVariable($_name, $_value, 'Process')
        }
    }
}

# Host-derived values stay native so PowerShell receives Windows paths.
$env:WARD_LOCKDOWN_ROOT = '{{ .ProjectsDir }}'
$env:_SIREN_SHELL_ENV = '1'

$_pathCandidates = @(
    'C:\Program Files\Git\usr\bin',
    'C:\Program Files\Git\bin',
    (Join-Path $HOME '.cargo\bin'),
    (Join-Path $HOME '.local\bin'),
    (Join-Path $HOME 'bin')
)
$_existingPaths = @($env:PATH -split [System.IO.Path]::PathSeparator |
    ForEach-Object { $_.TrimEnd('\', '/') })
$_prependPaths = @($_pathCandidates | Where-Object {
    (Test-Path -LiteralPath $_) -and $_existingPaths -notcontains $_.TrimEnd('\', '/')
})
if ($_prependPaths.Count -gt 0) {
    $env:PATH = (@($_prependPaths) + @($env:PATH)) -join [System.IO.Path]::PathSeparator
}
Remove-Variable _commonShellPath, _insideSharedEnvironment, _line, _name, _value,
    _pathCandidates, _existingPaths, _prependPaths -ErrorAction SilentlyContinue

# Defuse stuck xterm mouse-tracking modes (1000 click / 1002 drag / 1003
# any-motion / 1006 SGR encoding) that a TUI child can leave enabled when it
# exits or crashes without restoring them. A poisoned PTY then echoes every
# pointer move as a raw `^[[<35;X;YM` motion report, flooding the pane. The
# `35` button byte is 32 (motion) + 3 (no button), which only mode 1003 emits,
# so a TUI (a Linux tool under WSL, an Ink CLI) turned 1003 on and died dirty.
# Chain any existing prompt rather than replace it, so Warp's shell-integration
# prompt (OSC 133 block markers) is preserved. Worst case this is inert; it
# never clobbers Warp's prompt.
$script:__warpPriorPrompt = $function:prompt
function prompt {
    [Console]::Write("`e[?1000l`e[?1002l`e[?1003l`e[?1006l")
    if ($script:__warpPriorPrompt) { & $script:__warpPriorPrompt }
    else { "PS $($executionContext.SessionState.Path.CurrentLocation)> " }
}
