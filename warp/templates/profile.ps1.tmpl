# RENDERED FILE - do not edit by hand.
# Source of truth: agentic-os/warp/templates/profile.ps1.tmpl
# Rendered and symlinked to the pwsh 7 $PROFILE by `ward exec warp apply`.
#
# Auto-cd into the configured startup dir on shell start, matching Warp's
# StartupDir (settings.toml / startup_config.toml): the projects root by
# default, or a WARP_STARTUP_DIR override. Warp on the Windows host launches
# pwsh 7, so this is what lands new tabs. Guarded so the shell still opens
# cleanly if the directory is unmapped.
if (Test-Path '{{ .StartupDir }}') {
    Set-Location -Path '{{ .StartupDir }}'
}

# Import env vars and PATH additions from shell/common.sh via bash - single
# source of truth for all shells. PATH is handled separately: bash emits POSIX
# paths (/c/..., /x/...) which are converted to Windows form (C:\..., X:\...)
# and prepended if the directory exists and isn't already on Windows PATH.
$_bash = @(
    'C:\Program Files\Git\bin\bash.exe',
    'C:\msys64\usr\bin\bash.exe'
) | Where-Object { Test-Path $_ } | Select-Object -First 1
if ($_bash) {
    $_envOut = & $_bash --norc --noprofile -c "source '{{ .RepoRoot }}/shell/common.sh' 2>/dev/null && env" 2>$null
    $_bashPath = ''
    foreach ($_line in ($_envOut -split "`n")) {
        if ($_line -match '^([A-Za-z][A-Za-z0-9_]*)=(.*)$') {
            if ($Matches[1] -eq 'PATH') { $_bashPath = $Matches[2] }
            else { [System.Environment]::SetEnvironmentVariable($Matches[1], $Matches[2], 'Process') }
        }
    }
    # Convert POSIX PATH entries to Windows paths and prepend new ones.
    # /c/some/path  -> C:\some\path   (POSIX drive letter, Git Bash / MSYS2)
    # /x/some/path  -> X:\some\path
    # X:/some/path  -> X:\some\path   (Windows with forward slashes)
    # MSYS-internal paths (/usr/bin, /mingw64/bin) have no Windows equivalent;
    # Test-Path filters them out automatically.
    foreach ($_entry in ($_bashPath -split ':')) {
        $_win = if ($_entry -match '^/([a-zA-Z])/(.+)') {
            "$($Matches[1].ToUpper()):\$($Matches[2] -replace '/', '\')"
        } elseif ($_entry -match '^([a-zA-Z]):/(.+)') {
            "$($Matches[1].ToUpper()):\$($Matches[2] -replace '/', '\')"
        } else { $null }
        if ($_win -and (Test-Path $_win -ErrorAction SilentlyContinue) -and $env:PATH -notlike "*$_win*") {
            $env:PATH = "$_win;$env:PATH"
        }
    }
    Remove-Variable _envOut, _bashPath, _entry, _win -ErrorAction SilentlyContinue
}
Remove-Variable _bash -ErrorAction SilentlyContinue

# Defuse stuck xterm mouse-tracking modes (1000 click / 1002 drag / 1003
# any-motion / 1006 SGR encoding) that a TUI child can leave enabled when it
# exits or crashes without restoring them. A poisoned PTY then echoes every
# pointer move as a raw `^[[<35;X;YM` motion report, flooding the pane. The
# `35` button byte is 32 (motion) + 3 (no button), which only mode 1003 emits,
# so a TUI (a Linux tool under WSL, an Ink CLI) turned 1003 on and died dirty.
# Chain any existing prompt rather than replace it, so Warp's shell-integration
# prompt (OSC 133 block markers) is preserved. Worst case this is inert; it
# never clobbers Warp's prompt.
$script:__warpPriorPrompt = $function:prompt
function prompt {
    [Console]::Write("`e[?1000l`e[?1002l`e[?1003l`e[?1006l")
    if ($script:__warpPriorPrompt) { & $script:__warpPriorPrompt }
    else { "PS $($executionContext.SessionState.Path.CurrentLocation)> " }
}
