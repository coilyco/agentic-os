{
  "name": "dictation from a spoken phrase, recognised by the debug build's Vosk (phrase played from a file)",
  "start": "seat",
  "steps": [
    {
      "op": "recognizer",
      "service": "vosk",
      "input": "file"
    },
    {
      "op": "retry",
      "times": 3,
      "every": 20,
      "steps": [
        {
          "op": "fill",
          "selector": "#composer-input",
          "text": ""
        },
        {
          "op": "tap",
          "selector": "[aria-label=\"Dictate\"]"
        },
        {
          "op": "wait-value",
          "selector": "#composer-input",
          "pattern": "hello world this is a test",
          "timeout": 30
        }
      ]
    },
    {
      "op": "keyboard",
      "action": "close"
    },
    {
      "op": "shot",
      "name": "composer-after-spoken-phrase"
    },
    {
      "op": "recognizer",
      "service": "system"
    },
    {
      "op": "logcat",
      "name": "speech",
      "pattern": "vosk|speech|recogni|dictation"
    }
  ]
}
