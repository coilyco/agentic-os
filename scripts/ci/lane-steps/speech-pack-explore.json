{
  "name": "find the way to install Google's offline en-US speech pack (COI-3591)",
  "start": "none",
  "steps": [
    {"op": "adb", "args": ["shell", "am", "start", "-a", "android.settings.VOICE_INPUT_SETTINGS"]},
    {"op": "sleep", "seconds": 4},
    {"op": "ui-dump", "name": "voice-input"},
    {"op": "shot", "name": "voice-input"},
    {"op": "adb", "args": ["shell", "am", "start", "-n", "com.google.android.inputmethod.latin/com.android.inputmethod.latin.settings.SettingsActivity"]},
    {"op": "sleep", "seconds": 4},
    {"op": "ui-dump", "name": "gboard"},
    {"op": "shot", "name": "gboard"},
    {"op": "adb", "args": ["shell", "am", "start", "-a", "com.google.android.googlequicksearchbox.action.OPEN_SETTINGS"]},
    {"op": "sleep", "seconds": 4},
    {"op": "ui-dump", "name": "google-app"},
    {"op": "shot", "name": "google-app"},
    {"op": "adb", "args": ["shell", "pm list packages | grep -i -E 'tts|speech|voice|googlequicksearchbox|inputmethod'"]},
    {"op": "adb", "args": ["shell", "cmd package resolve-activity --brief -a android.settings.VOICE_INPUT_SETTINGS"]},
    {"op": "logcat", "name": "packs", "pattern": "language pack|soda|MDD.*download|datadownload"}
  ]
}
