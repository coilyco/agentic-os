{
  "name": "which espeak voice does Vosk's small model recognise best (COI-3591)",
  "start": "seat",
  "steps": [
    {
      "op": "recognizer",
      "service": "vosk",
      "input": "file",
      "variant": 1
    },
    {
      "op": "fill",
      "selector": "#composer-input",
      "text": ""
    },
    {
      "op": "tap",
