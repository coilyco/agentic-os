{
  "name": "does the recognizer keep listening with the screen off (COI-3466)",
  "start": "seat",
  "steps": [
    {
      "op": "recognizer",
      "service": "vosk",
      "input": "mic"
    },
    {
      "op": "fill",
      "selector": "#composer-input",
      "text": ""
    },
    {
      "op": "tap",
      "selector": "[aria-label=\"Dictate\"]"
    },
    {
      "op": "sleep",
      "seconds": 8
    },
    {
      "op": "eval",
      "js": "JSON.stringify({listening: !!document.querySelector('[aria-label=\"Stop dictating\"]'), state: document.visibilityState})",
      "save": "awake_before"
    },
    {
      "op": "adb",
      "args": [
        "shell",
        "input",
        "keyevent",
        "26"
      ]
    },
    {
      "op": "sleep",
      "seconds": 3
    },
    {
      "op": "adb",
      "args": [
        "shell",
        "dumpsys power | grep -m2 -E 'mWakefulness=|Display Power'"
      ]
    },
    {
      "op": "sleep",
      "seconds": 30
    },
    {
      "op": "adb",
      "args": [
        "shell",
        "dumpsys audio | grep -i -E 'silenc|session:' | head -10"
      ]
    },
    {
      "op": "adb",
      "args": [
        "shell",
        "input",
        "keyevent",
        "224"
      ]
    },
    {
      "op": "sleep",
      "seconds": 3
    },
    {
      "op": "eval",
      "js": "JSON.stringify({listening: !!document.querySelector('[aria-label=\"Stop dictating\"]'), state: document.visibilityState})",
      "save": "awake_after"
    },
    {
      "op": "shot",
      "name": "after-wake"
    },
    {
      "op": "recognizer",
      "service": "system"
    },
    {
      "op": "logcat",
      "name": "speech",
      "pattern": "vosk|recogni|dictation|silenc"
    }
  ]
}
