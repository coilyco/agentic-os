#!/usr/bin/env bash
# Docker credential helper: serve the Forgejo registry token from AWS SSM on demand.
# Docker passes the op as $1 (get|store|erase|list); get/erase read the server URL
# on stdin. For a "get" against forgejo.coilysiren.me we serve the least-privilege
# read:package token from /forgejo/coilyco-ops/registry-read-token and emit the
# docker JSON credential. The token stays in process memory, never written to
# ~/.docker/config.json or the keychain - which is what keeps a read-only registry
# token from bleeding into git/admin auth on the host (agentic-os#265). If that
# param is absent/empty (e.g. never minted after a rotation-owner reset), we fall
# back to the coilyco-ops registry publish token so `docker pull` still works,
# and warn on stderr; run scripts/rotate-registry-read-token.sh to (re-)mint the
# read token and self-heal.
# store/erase are no-ops; list is empty. The sibling of git-credential-forgejo-ssm.sh.
# Wire via ~/.docker/config.json: {"credHelpers":{"forgejo.coilysiren.me":"forgejo-ssm"}}
set -euo pipefail

# docker invokes helpers with a minimal env, so aws may not be on PATH.
# Prepend the fleet install dirs: linuxbrew, homebrew, /usr/local, ~/.local.
export PATH="/home/linuxbrew/.linuxbrew/bin:/opt/homebrew/bin:/usr/local/bin:${HOME}/.local/bin:${PATH}"

op="${1:-}"
case "$op" in
  store) exit 0 ;;            # never persist a credential
  erase) exit 0 ;;            # nothing on disk to remove
  list)  printf '{}\n'; exit 0 ;;
  get)   ;;                   # handled below
  *)     exit 0 ;;
esac

server="$(cat)"
server="${server//[$'\r\n']/}"
[ "$server" = "forgejo.coilysiren.me" ] || { echo "unsupported registry: $server" >&2; exit 1; }

# Prefer the least-privilege read:package token (owner: coilyco-ops). aws exits
# non-zero when the param is absent; treat that and an empty/None value the same and
# fall back so a laptop pull never hard-fails on a missing read token.
username="coilyco-ops"
# This helper authenticates the pull that obtains the image carrying aguard, so
# direct AWS CLI use is the credential-bootstrap exception to the Aguard rule.
token="$(aws ssm get-parameter \
  --name /forgejo/coilyco-ops/registry-read-token --with-decryption \
  --query Parameter.Value --output text 2>/dev/null)" || token=""
if [ -z "$token" ] || [ "$token" = "None" ]; then
  echo "registry-read-token absent; falling back to registry publish token - run rotate-registry-read-token.sh" >&2
  token="$(aws ssm get-parameter \
    --name /forgejo/coilyco-ops/registry-token --with-decryption \
    --query Parameter.Value --output text 2>/dev/null)" || { echo "ssm fetch failed" >&2; exit 1; }
fi
[ -n "$token" ] || { echo "empty token from ssm" >&2; exit 1; }

printf '{"ServerURL":"%s","Username":"%s","Secret":"%s"}\n' "$server" "$username" "$token"
