#!/usr/bin/env bash
# gpg-ssm - GPG wrapper that pulls the signing-key passphrase from AWS SSM
# instead of caching it in macOS Keychain or anywhere else on disk.
#
# Wire-up:
#   git config --global gpg.program "$HOME/.local/bin/gpg-ssm"
#
# SSM params:
#   /coilysiren/gpg-secret-key   (SecureString, armored secret key)
#   /coilysiren/gpg-passphrase    (SecureString, signing passphrase)
# The configured signing key comes from `git config --global --get
# user.signingkey`. If the key is not already local, the wrapper bootstraps
# it from SSM before signing.
#
# Behavior:
#   - Verification / non-signing gpg invocations pass through untouched.
#   - For signing invocations, runs `aws sts get-caller-identity` first as
#     a fail-fast credential gate, bootstraps the shared secret key from
#     SSM when it is not already local, then fetches the passphrase from
#     SSM and hands it to gpg via --passphrase-fd 3 (no command-line
#     exposure).
#   - After the first successful sign in a session, gpg-agent caches the
#     unlocked key in memory and subsequent signs reuse it without
#     re-invoking SSM (provided default-cache-ttl in gpg-agent.conf is
#     long enough; ~1yr is the recommended setting).
set -euo pipefail

# Git Bash mangles leading-slash args into Windows paths; opt out so SSM
# names like /coilysiren/gpg-passphrase survive intact.
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) export MSYS_NO_PATHCONV=1 ;;
esac

needs_sign=0
for arg in "$@"; do
  case "$arg" in
    --sign|--clearsign|--clear-sign|--detach-sign)
      needs_sign=1
      break
      ;;
    --*)
      # Some other long option; not a signing trigger.
      ;;
    -*s*)
      # Short-option bundle containing 's' (e.g. -s, -bs, -bsau as git
      # itself invokes us). Match via glob since gpg combines flags.
      needs_sign=1
      break
      ;;
  esac
done

if [ "$needs_sign" -eq 0 ]; then
  exec gpg "$@"
fi

keyid=$(git config --global --get user.signingkey 2>/dev/null || true)
if [ -z "$keyid" ]; then
  echo "gpg-ssm: user.signingkey is unset in global git config; can't resolve SSM passphrase param." >&2
  exit 1
fi

needs_key_import=0
if ! gpg --batch --with-colons --list-secret-keys "$keyid" 2>/dev/null | grep -q '^sec:'; then
  needs_key_import=1
fi

if ! ward ops aws sts get-caller-identity >/dev/null 2>&1; then
  echo "gpg-ssm: AWS credentials expired or missing. Run 'aws sso login' and retry." >&2
  exit 1
fi

fetch_ssm_value() {
  local ssm_name="$1"
  ward ops aws ssm get-parameter \
    --name "$ssm_name" \
    --with-decryption \
    --query Parameter.Value \
    --output text 2>/dev/null
}

if [ "$needs_key_import" -eq 1 ]; then
  secret_key=$(fetch_ssm_value "/coilysiren/gpg-secret-key") || {
    echo "gpg-ssm: failed to fetch /coilysiren/gpg-secret-key from SSM." >&2
    exit 1
  }
  if ! printf '%s' "$secret_key" | gpg --batch --import >/dev/null 2>&1; then
    echo "gpg-ssm: failed to import shared secret key from SSM." >&2
    exit 1
  fi
fi

pass=$(fetch_ssm_value "/coilysiren/gpg-passphrase") || {
  echo "gpg-ssm: failed to fetch /coilysiren/gpg-passphrase from SSM." >&2
  exit 1
}

exec gpg --batch --pinentry-mode loopback --passphrase-fd 3 "$@" \
  3< <(printf '%s' "$pass")
