{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "aterm",
  "version": "0.1.0",
  "identifier": "dev.coilyco.aterm",
  "build": {
    "frontendDist": "../../aterm-client/dist"
  },
  "app": {
    "windows": [
      {
        "title": "aterm",
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 30
    }
  }
}
