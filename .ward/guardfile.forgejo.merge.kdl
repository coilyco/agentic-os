// Forgejo PR-LIFECYCLE overlay - director-completion authority (agentic-os#446)
// plus the mutating pull-request lifecycle (agentic-os#488). "merge" in the
// filename names the anchor grant, but the overlay now carries the whole
// mutating pr family: create, edit, close, reopen, and branch update beside
// the original merge pair. This deliberately lives OUTSIDE the read -> write
// -> admin tier chain: the shared read/write tiers inherit those shared grants, and PR
// mutation binds to the director, engineer, and pm roles only (roles.kdl), so
// it rides its own overlay the way the Actions log bridge does. The pr READ
// side (view/list/files/commits) lives in guardfile.forgejo.read.kdl, which
// those roles already inherit.
//
// The merge pair backs the `ward agent director merge` composite - merge only
// a PR whose issue thread authorizes director merge - so the guarded verb is
// the transport, not the policy: thread authorization stays with the
// composite, and the lifecycle verbs added here do not widen it. Actions
// rerun is intentionally absent (the pinned swagger has no rerun
// operationId); it rides the guarded custom verb tracked in agentic-os#434
// and joins the director/engineer tier once that lands.
// Every leaf pins its op - the bare convention does not reach the pulls
// sub-resources. See ../docs/ward-specs.md.
wrap ward-kdl-merge ops forgejo {
    spec forgejo.swagger.v1.json
    base-url "forgejo.coilysiren.me/api/v1"
    // Auth as the coilyco-ops bot (ward#151), matching the monolith surface.
    auth header-token {
        header Authorization
        prefix "token "
        value ssm "/forgejo/coilyco-ops/api-token"
    }
    // Scope gate: every leaf whose path carries {owner} must name a coily* owner.
    restrict owner matches coily*
    can is-merged pr {
        op repoPullRequestIsMerged
        describe "whether a PR is already merged (GET /repos/{owner}/{repo}/pulls/{index}/merge): the idempotent pre-flight read beside `pr merge`. op pinned like the monolith's pr leaves - the bare convention does not reach the merge sub-resource."
    }
    can merge pr {
        op repoMergePullRequest
        describe "merge a pull request (POST /repos/{owner}/{repo}/pulls/{index}/merge) - the director-completion verb (agentic-os#446). Backs `ward agent director merge`: merge only a PR whose issue thread authorizes director merge, never as a blanket sweep. {owner}-scoped by the coily* gate above; bound to the director and engineer roles only (roles.kdl), never the shared read/write tiers."
    }
    can create pr {
        op repoCreatePullRequest
        describe "open a pull request (POST /repos/{owner}/{repo}/pulls): --title plus --head and --base branch names. The authoring end of the lifecycle (agentic-os#488)."
    }
    can edit pr {
        op repoEditPullRequest
        describe "edit a pull request's title/body/state fields (PATCH /repos/{owner}/{repo}/pulls/{index}). Prefer the fixed-body `pr close` / `pr reopen` toggles for state flips."
    }
    can close pr {
        op repoEditPullRequest
        body state=closed
        describe "close a pull request without merging (PATCH state=closed): the stranded-PR cleanup verb (agentic-os#488). Reversible with `pr reopen`, so a wrong close is not a wall."
    }
    can reopen pr {
        op repoEditPullRequest
        body state=open
        describe "reopen a closed, unmerged pull request (PATCH state=open): the inverse of `pr close`."
    }
    can update pr {
        op repoUpdatePullRequest
        describe "update a stale PR head branch from its base (POST /repos/{owner}/{repo}/pulls/{index}/update), e.g. pull main into a branch that fell behind (agentic-os#488)."
    }
}
