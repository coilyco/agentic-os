// GENERATED by generate_gh_seat_guardfile.py from ../../shims/gh/gh.kdl, which
// is the file to edit. Only the exec lines differ.

wrap gh {
    exec aterm {
        argv-prefix "gh-exec"
    }
    replace "gh"

    // Naming a verb here takes something away. Everything unnamed is the
    // ordinary gh, which is the point: this file is a boundary, not a catalog.
    default-allow {
        reason "gh is a read tool the fleet uses across a dozen verbs, and one of them is a boundary. Enumerating the rest would be an inventory that rots against GitHub's releases rather than against this policy, and a verb nobody thought of would be a verb the fleet silently lost."
    }

    // Allowlisted to a GET: `gh api -f x=y <path>` is a POST with no method
    // flag, so a deny list never sees it. Reference doc carries the rest.
    can run api {
        allow-flag "--cache"
        allow-flag "--jq"
        allow-flag "--paginate"
        allow-flag "--slurp"
        allow-flag "--hostname"
        value-flag "--cache"
        value-flag "--jq"
        value-flag "--hostname"
        describe "read-only GitHub REST GET. No method, field, or input flag mounts, so a write cannot be spelled through here"
    }

    // GitHub-canonical repos: one joins every list below in the change that flips its
    // mirror direction (COI-2975). Why --repo is required: references/gh-replacement.md.
    can run "pr create" {
        when repo matches "coilyco/bluesky-mcp" "coilyco/homebrew-tap" "coilyco/scoop-bucket"
        deny-flag "-R" aliases="none"
        describe "open a pull request on a GitHub-canonical repo. Needs --repo OWNER/REPO naming one. Any other repo is Forgejo-canonical: run `aosguard ops forgejo pr create`"
    }
    can run "pr edit" {
        when repo matches "coilyco/bluesky-mcp" "coilyco/homebrew-tap" "coilyco/scoop-bucket"
        deny-when any-arg matches "*://*"
        deny-flag "-R" aliases="none"
        value-flag "--repo"
        value-flag "--add-assignee"
        value-flag "--add-label"
        value-flag "--add-project"
        value-flag "--add-reviewer"
        value-flag "--attach"
        value-flag "--base"
        value-flag "--body"
        value-flag "--body-file"
        value-flag "--milestone"
        value-flag "--remove-assignee"
        value-flag "--remove-label"
        value-flag "--remove-project"
        value-flag "--remove-reviewer"
        value-flag "--title"
        describe "edit a pull request on a GitHub-canonical repo. Needs --repo OWNER/REPO naming one and a number or branch, never a URL. Any other repo is Forgejo-canonical: run `aosguard ops forgejo pr edit`"
    }
    // A URL selector overrides --repo in gh, so it is refused. Squash only:
    // gh needs a method flag off a tty, and merge, rebase and admin are denied.
    can run "pr merge" {
        when repo matches "coilyco/bluesky-mcp" "coilyco/homebrew-tap" "coilyco/scoop-bucket"
        deny-when any-arg matches "*://*"
        deny-flag "-R" aliases="none"
        deny-flag "--merge" aliases="-m"
        deny-flag "--rebase" aliases="-r"
        deny-flag "--admin" aliases="none"
        value-flag "--repo"
        value-flag "--author-email"
        value-flag "--body"
        value-flag "--body-file"
        value-flag "--match-head-commit"
        value-flag "--subject"
        describe "squash-merge a pull request on a GitHub-canonical repo. Needs --repo OWNER/REPO naming one and a number or branch, never a URL. Any other repo is Forgejo-canonical: run `aosguard ops forgejo pr merge`"
    }

    // Reversible, so granted on the same repos. `review` stays withheld below.
    can run "pr close" {
        when repo matches "coilyco/bluesky-mcp" "coilyco/homebrew-tap" "coilyco/scoop-bucket"
        deny-when any-arg matches "*://*"
        deny-flag "-R" aliases="none"
        value-flag "--repo"
        value-flag "--comment"
        describe "close a pull request on a GitHub-canonical repo. Needs --repo OWNER/REPO naming one and a number or branch, never a URL. Any other repo is Forgejo-canonical: run `aosguard ops forgejo pr close`"
    }
    can run "pr reopen" {
        when repo matches "coilyco/bluesky-mcp" "coilyco/homebrew-tap" "coilyco/scoop-bucket"
        deny-when any-arg matches "*://*"
        deny-flag "-R" aliases="none"
        value-flag "--repo"
        value-flag "--comment"
        describe "reopen a pull request on a GitHub-canonical repo. Needs --repo OWNER/REPO naming one and a number or branch, never a URL. Any other repo is Forgejo-canonical: run `aosguard ops forgejo pr reopen`"
    }
    can run "pr comment" {
        when repo matches "coilyco/bluesky-mcp" "coilyco/homebrew-tap" "coilyco/scoop-bucket"
        deny-when any-arg matches "*://*"
        deny-flag "-R" aliases="none"
        value-flag "--repo"
        value-flag "--attach"
        value-flag "--body"
        value-flag "--body-file"
        describe "comment on a pull request on a GitHub-canonical repo. Needs --repo OWNER/REPO naming one and a number or branch, never a URL. Any other repo is Forgejo-canonical: comment on the Forgejo pull request"
    }
    can run "pr ready" {
        when repo matches "coilyco/bluesky-mcp" "coilyco/homebrew-tap" "coilyco/scoop-bucket"
        deny-when any-arg matches "*://*"
        deny-flag "-R" aliases="none"
        value-flag "--repo"
        describe "mark a pull request ready, or draft with --undo, on a GitHub-canonical repo. Needs --repo OWNER/REPO naming one and a number or branch, never a URL. Any other repo is Forgejo-canonical"
    }

    // `gh api` stays a GET, because a write flag there cannot be pinned to one
    // endpoint. This leaf is `gh api --method PUT` and nothing else.
    can run actions-permissions {
        argv "api" "--method" "PUT"
        when arg0 matches "repos/coilyco/bluesky-mcp/actions/permissions" "repos/coilyco/homebrew-tap/actions/permissions" "repos/coilyco/scoop-bucket/actions/permissions"
        allow-flag "--field"
        allow-flag "--raw-field"
        value-flag "--field"
        value-flag "--raw-field"
        describe "set GitHub Actions permissions on a GitHub-canonical repo: actions-permissions repos/OWNER/REPO/actions/permissions --field enabled=true. Long flags only"
    }

    withhold pr review {
        reason "withheld on every repo, listed or not. On a Forgejo-canonical repo a review written here is addressed to a copy nobody merges from, so review the Forgejo pull request."
    }
}
