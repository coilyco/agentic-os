// The guarded `git`: a replacement binary an agent session's PATH puts first.
// Rationale: tooling-aosguard references/git-shim.md.

wrap git {
    exec git
    replace

    // Everything unnamed is the ordinary git. Naming a verb here takes something away.
    default-allow {
        reason "git is the fleet's everyday tool and a handful of spellings are the boundary: skipping a hook, rewriting a remote. Enumerating the rest would be an inventory that rots against git's releases rather than against this policy."
    }

    // aliases= binds only on umbra v0.254.0+, older ones parse it and ignore it.
    // Without them `commit -n` and `push -f` pass (COI-1899).
    can run commit {
        deny-flag "--no-verify" aliases="-n"
    }
    can run push {
        deny-flag "--force" aliases="-f"
        deny-flag "--force-with-lease" aliases="none"
        deny-flag "--force-if-includes" aliases="none"
        deny-flag "--no-verify" aliases="none"
        // A leading + forces one ref with no flag at all.
        deny-when any-arg matches "+*"
    }
    can run merge {
        deny-flag "--no-verify" aliases="none"
    }

    // core.hooksPath moved skips every hook as --no-verify does. Keys are
    // case-insensitive, so each spelling is listed.
    never pass "*hookspath*" "*HOOKSPATH*" "*hooksPath*" "*Hookspath*" "*HooksPath*"
}
