// Application-aware Forgejo storage measurement.
// Rationale: tooling-aosguard references/guardfile-headers.md.

wrap aosguard ops forgejo-storage {
    exec python3

    can run measure {
        argv "-I"
        embed "forgejo_storage_measure.py"
        sealed
        describe "collect bounded read-only Forgejo filesystem and PostgreSQL storage evidence"
    }
}
