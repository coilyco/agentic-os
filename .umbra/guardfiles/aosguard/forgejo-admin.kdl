// Forgejo operations Forgejo refuses to the coilyco-ops bot.
// Rationale: tooling-aosguard references/guardfile-headers.md.

wrap aosguard ops forgejo-admin {
    // Same store and shape as the ordinary wrapper, pointed at the admin PAT.
    provider ssm {
        exec aws ssm get-parameter --with-decryption --output text --query "Parameter.Value" --name
    }

    spec forgejo-admin.swagger.v1.json.gz
    base-url "forgejo.coilysiren.me/api/v1"
    auth header-token {
        header Authorization
        prefix "token "
        value ssm "/forgejo/admin-token"
    }
    restrict owner matches coily*

    // Repo settings and cosmetics. EditRepoOption carries the merge policy
    // forgejo-repo-settings.py converges; `private` and `archived` ride along.
    can edit repo
    can get repo {
        describe "read a repository's current settings, so a converge can diff before it writes"
    }
    can replace-all repo-topic {
        op repoUpdateTopics
        describe "replace the complete repository topic set (PUT /repos/{owner}/{repo}/topics); repeat --topics for each retained topic"
    }

    // Org labels: every write needs org ownership, which is why the ordinary
    // wrapper answers a pointer here. Reads stay available on both.
    can get org-label
    can list org-label
    can create org-label {
        describe "mint an org label (POST /orgs/{org}/labels); pass --exclusive for a scoped group like priority/* or autonomy/* so the tracker enforces one value per issue"
    }
    can edit org-label {
        describe "rename or restyle an org label in place (PATCH /orgs/{org}/labels/{id}). An edit keeps the label id, so every issue carrying it keeps it through a rename - this is the safe way to move a taxonomy"
    }
    can delete org-label {
        describe "irreversible: removes the label from every issue that carries it. Prefer `edit org-label` for a rename, which preserves those associations"
    }

    // Repo labels: Forgejo mints labels per organization, and coilysiren is a
    // user account, so its six repos have no org to hang one on (#1377).
    can create label {
        op issueCreateLabel
        describe "mint a repository label (POST /repos/{owner}/{repo}/labels), for a user-owned repository with no organization to carry one. On an org-owned repo prefer `create org-label`: a repo label duplicating an org label silently shadows it, which is the ward#107 path, and it stays denied on the ordinary wrapper"
    }

    // Branch protection: converged whenever the repo set changes, most often
    // right after creating a repo, so it is routine rather than exceptional.
    can list branch-protection {
        op repoListBranchProtection
        describe "list the protection rules on a repository (GET /repos/{owner}/{repo}/branch_protections). op pinned because a bare `list branch` resolves here rather than to the branch list"
    }
    can get branch-protection {
        op repoGetBranchProtection
    }
    can create branch-protection {
        op repoCreateBranchProtection
        describe "protect a branch (POST /repos/{owner}/{repo}/branch_protections). Run it on a newly created repo, which starts unprotected"
    }
    can edit branch-protection {
        op repoEditBranchProtection
        describe "converge an existing rule (PATCH /repos/{owner}/{repo}/branch_protections/{name}). Idempotent: re-running a matching rule changes nothing"
    }

    // Actions secrets. Five provisioning scripts wrote these with a raw curl
    // and the PAT in a shell variable; the verb keeps it inside the binary.
    can list repo-actions-secret {
        op repoListActionsSecrets
    }
    can update repo-actions-secret {
        op updateRepoSecret
        describe "create or replace a repository Actions secret (PUT /repos/{owner}/{repo}/actions/secrets/{secretname}); the value never appears in argv"
    }
    can delete repo-actions-secret {
        op deleteRepoSecret
    }
    can list org-actions-secret {
        op orgListActionsSecrets
    }
    can update org-actions-secret {
        op updateOrgSecret
        describe "create or replace an organization Actions secret (PUT /orgs/{org}/actions/secrets/{secretname})"
    }
    can delete org-actions-secret {
        op deleteOrgSecret
    }

    // Runner registration tokens, minted per org or per repo when a runner is
    // provisioned. Read-only against the API; the value is a fresh credential.
    can get org-runner-registration-token {
        op orgGetRunnerRegistrationToken
    }
    can get repo-runner-registration-token {
        op repoGetRunnerRegistrationToken
    }

    // Package retention, which runs on a timer rather than by hand.
    can list package {
        op listPackages
    }
    can get package {
        op getPackage
    }
    can delete package {
        op deletePackage
        describe "irreversible: removes one package version and its files"
    }

    // Repository contents. Not an admin concern, but the ordinary wrapper has
    // no contents verb at all, so it lands here for now. See deploy#545.
    can get repo-content {
        op repoGetContents
        describe "read one file from a repository (GET /repos/{owner}/{repo}/contents/{filepath})"
    }
    can list repo-content {
        op repoGetContentsList
    }

    // Personal access tokens for the bot user, rotated rather than minted once.
    can list user-token {
        op userGetTokens
    }
    can create user-token {
        op userCreateToken
        describe "mint a PAT for a user (POST /users/{username}/tokens). The response carries the only copy of the secret, so treat the output as the credential"
    }
    can delete user-token {
        op userDeleteAccessToken
        describe "irreversible: revokes the named token immediately"
    }

    // aosguard operates the estate; it does not create principals in it. A
    // guard that can mint a user can mint one with any rights. Kai, 2026-08-16.
    never create user {
        op adminCreateUser
        message "aosguard does not create Forgejo users: a guard that can mint a principal can mint one with any rights. Bootstrap scripts read /forgejo/admin-token from SSM directly - see scripts/provision-coilyco-ops-bot.sh in coilyco-bridge/infrastructure"
    }
    never delete user {
        op adminDeleteUser
        message "aosguard does not delete Forgejo users; do it in the web UI or from a bootstrap script holding the admin PAT"
    }
    never create admin-org {
        op adminCreateOrg
        message "aosguard does not create organizations; org creation stays human-only, as it is on the ordinary wrapper"
    }
}
