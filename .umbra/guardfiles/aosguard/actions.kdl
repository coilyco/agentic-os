// AOSguard's Forgejo Actions log bridge, the one Actions verb needing code.
// Rationale: tooling-aosguard references/guardfile-headers.md.

wrap aosguard ops actions {
    // The ssm value provider: umbra ships no store SDK, so a store-backed
    // source is an exec contract, declared here rather than linked in.
    provider ssm {
        exec aws ssm get-parameter --with-decryption --output text --query "Parameter.Value" --name
    }

    exec python3 {
        env FORGEJO_TOKEN {
            value ssm "/forgejo/coilyco-ops/api-token"
        }
    }

    // -P keeps the caller's cwd off sys.path, which a `-m` exec otherwise
    // prepends ahead of the bundled module (agentic-os#6837).
    can run logs {
        argv "-P" "-m" "agentic_os.forgejo_actions_logs"
        when arg0 matches coily*
        describe "fetch bounded whole-run ZIP or single-job log bytes through the Forgejo 16 API"
    }
}
