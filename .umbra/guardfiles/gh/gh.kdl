// The guarded `gh`: a replacement binary an agent session's PATH puts first.
// Rationale: tooling-aosguard references/gh-replacement.md.

wrap gh {
    exec gh
    replace

    // Naming a verb here takes something away. Everything unnamed is the
    // ordinary gh, which is the point: this file is a boundary, not a catalog.
    default-allow {
        reason "gh is a read tool the fleet uses across a dozen verbs, and one of them is a boundary. Enumerating the rest would be an inventory that rots against GitHub's releases rather than against this policy, and a verb nobody thought of would be a verb the fleet silently lost."
    }

    // Allowlisted to a GET: `gh api -f x=y <path>` is a POST with no method
    // flag, so a deny list never sees it. Reference doc carries the rest.
    can run api {
        allow-flag "--cache"
        allow-flag "--jq"
        allow-flag "--paginate"
        allow-flag "--slurp"
        allow-flag "--hostname"
        value-flag "--cache"
        value-flag "--jq"
        value-flag "--hostname"
        describe "read-only GitHub REST GET. No method, field, or input flag mounts, so a write cannot be spelled through here"
    }

    // Pull-request writes. Stated rather than absent: an unnamed verb forwards
    // now, so silence would hand the caller the very thing this refuses.
    withhold pr create {
        reason "Forgejo is canonical and GitHub is a read-only downstream mirror, so a pull request opened here lands work on the copy and the next mirror push fails as a non-fast-forward. Push the branch to origin and run `aosguard ops forgejo pr create` instead."
    }
    withhold pr merge {
        reason "merging on the mirror writes a commit Forgejo never sees, which is the divergence only a human admin with a force-push can repair. Merge the Forgejo pull request with `aosguard ops forgejo pr merge`."
    }
    withhold pr edit {
        reason "the pull request this would edit belongs on Forgejo. Edit it there with `aosguard ops forgejo pr edit`."
    }
    withhold pr close {
        reason "closing a mirror pull request decides something on the copy. `aosguard ops forgejo pr close` acts on the canonical one."
    }
    withhold pr reopen {
        reason "reopening a mirror pull request decides something on the copy. `aosguard ops forgejo pr reopen` acts on the canonical one."
    }
    withhold pr ready {
        reason "draft state belongs to the canonical pull request on Forgejo, not to its mirror."
    }
    withhold pr review {
        reason "a review written here is addressed to a copy nobody merges from. Review the Forgejo pull request."
    }
    withhold pr comment {
        reason "a comment here sits on the mirror, where the author is not reading. Comment on the Forgejo pull request."
    }
}
